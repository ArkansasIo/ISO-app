NODE_ENV=development
PORT=8080
DATABASE_URL=mysql://ide:change-me@localhost:3306/github_universal_ide
CORS_ORIGIN=http://localhost:8080
CRON_ENABLED=true
CRON_TIMEZONE=America/Toronto
CRON_CATALOG_REFRESH=*/30 * * * *
CRON_EXPIRED_JOB_CLEANUP=15 * * * *
CRON_HEALTH_SAMPLE=*/5 * * * *
CRON_REPOSITORY_SYNC=0 */6 * * *
JOB_RETENTION_DAYS=30
SESSION_TTL_HOURS=168
APP_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret
GITHUB_CLIENT_ID=optional-github-oauth-app-client-id
GITHUB_TOKEN=optional-server-token-for-public-or-service-repo-access
WORKER_URL=
WORKER_SHARED_SECRET=
